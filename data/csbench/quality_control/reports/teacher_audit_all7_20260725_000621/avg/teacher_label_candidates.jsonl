{"U_E": 0.0, "U_R": 0.0, "U_S": 0.5, "absolute_difference": 6.5, "answer_id": "ANS_CO_497", "candidate_threshold": 1.5, "candidate_type": "possible_teacher_over_score", "confounds": "", "corrected_score": "", "extraction_quality": "high", "final_calibrated_score": 3.5, "human_decision": "", "max_score": 10.0, "model_avg_score": 3.5, "question_id": "CO_7", "raw_text": "解：F1=4GHz=4×10^-9Hz  F2=6GHz=6×10^-9Hz\nIC=10×10⁵=1×10⁶\nCPI1=2  CPI2=1\nTe=m×T\nT=1/F      \nCPI=m/IC\n⇒ Te= (CPI×IC)/F\n程序P在M1上的运行时间Te1= (2×1×10⁶)/(4×10⁹)=5×10⁻⁴s\n程序P在M2上的运行时间Te2= (1×1×10⁶)/(6×10⁹)=1.667×10⁻⁴s", "reference_score": 3.5, "reference_score_key": "model_avg_score", "review_note": "", "review_priority": "P1", "route": "POS", "selected_baseline_score": 3.5, "std_dev": 0.4082, "student_image": "data/csbench/student_images/CO_7/ANS_CO_497.jpg", "teacher_minus_reference": 6.5, "teacher_score": 10.0, "three_way_core_score": 3.5}

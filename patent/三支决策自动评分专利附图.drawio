  <diagram id="fig4" name="图4-非对称三支决策">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="1" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="f4t" value="图4 基于非对称损失双阈值的三支决策分流" style="text;html=1;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="210" y="20" width="740" height="40" as="geometry"/></mxCell>
        <mxCell id="f4a" value="输入安全自动评分隶属度 μ、基线分 s_base 和损失参数" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="350" y="80" width="460" height="60" as="geometry"/></mxCell>
        <mxCell id="f4b" value="计算非对称双阈值&#xa;α=(λ₁+λ₂m)/(λ₁+λ₂)；β=μ₂m/(μ₁+μ₂)&#xa;其中 μ₁、μ₂ 为损失参数" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="350" y="180" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="f4n" value="是否满足无可用证据等硬拒判条件？" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="430" y="310" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="f4r" value="比较 μ 与 α、β" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="430" y="470" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="f4c" value="POS：自动接受&#xa;μ≥α，输出基线分 s_base" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="70" y="670" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="f4d" value="BND：边界域&#xa;β&lt;μ&lt;α，执行受限仲裁" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="445" y="670" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="f4e" value="NEG：人工复核&#xa;μ≤β或触发硬拒判" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="820" y="670" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="f4e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1" edge="1" parent="1" source="f4a" target="f4b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1" edge="1" parent="1" source="f4b" target="f4n"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4e3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1" edge="1" parent="1" source="f4n" target="f4r"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0.75;entryY=0;entryPerimeter=1" edge="1" parent="1" source="f4n" target="f4e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="365"/><mxPoint x="1060" y="630"/><mxPoint x="1022.5" y="630"/></Array></mxGeometry></mxCell>

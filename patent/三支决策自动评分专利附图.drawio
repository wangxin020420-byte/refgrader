        <mxCell id="f3t" value="图3 三类风险与安全自动评分隶属度计算" style="text;html=1;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="230" y="25" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="f3a" value="风险计算输入&#xa;逐评分项证据、探针分数和逐项判定" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="60" y="270" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="f3b" value="证据质量风险 U_E&#xa;U_E=1-Σ(p_i q_i)/Σp_i" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="390" y="110" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="f3c" value="评分稳定性风险 U_S&#xa;U_S=min(1,d_s/(γS))" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="390" y="280" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="f3d" value="评分项映射风险 U_R&#xa;共识风险与证据冲突风险取最大值" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff" vertex="1" parent="1"><mxGeometry x="390" y="450" width="300" height="90" as="geometry"/></mxCell>

logs/
results_runs/
outputs/csbench_*_compare.csv
outputs/csbench_*_summary.json

# Generated rubric products are published/restored through refgrader-artifacts.
# Authoritative source/initial rubrics under data/csbench remain versioned here.
data/csbench/rubrics/optimized/
data/csbench/rubrics/manifests/

# External CSBench source dataset (keep it outside this repository)
/CSBench_new/
/csbenchnew/
/csbench_new/
*.pid
